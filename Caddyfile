# Optional reverse proxy for users who already have Caddy installed.
# Native development uses Vite's built-in proxy and does not require this file.
#
# Port: Service
# =============
# 1111: Caddy (optional entrypoint)
# 1109: Backend (Uvicorn / FastAPI)
# 1110: Frontend (Vite)

http://localhost:1111

reverse_proxy /ws http://localhost:1109
reverse_proxy /ws/* http://localhost:1109
reverse_proxy /api http://localhost:1109
reverse_proxy /api/* http://localhost:1109
reverse_proxy /docs http://localhost:1109
reverse_proxy /docs/* http://localhost:1109
reverse_proxy /openapi.json http://localhost:1109
reverse_proxy * http://localhost:1110
