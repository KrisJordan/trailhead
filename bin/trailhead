#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Compatibility wrapper; installed users should use the `trailhead` command."""

import re
import sys
from trailhead.__main__ import main

if __name__ == "__main__":
    sys.argv[0] = re.sub(r"(-script\.pyw|\.exe)?$", "", sys.argv[0])
    sys.exit(main())
